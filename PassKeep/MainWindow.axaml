<Window
    x:Class="PassKeep.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PassKeep.Views"
    xmlns:modeles="clr-namespace:PassKeep.modeles"

    Width="760"
    Height="760"
    MinWidth="600"
    MinHeight="680"
    Title="PassKeep"
    Background="#0B1220"
    Topmost="True"
    Icon="/assets/passkeepIcon.png"
    SystemDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40">

    <Grid RowDefinitions="40,*">

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="12,0,12,0">

                <!-- Zone draggable -->
                <Grid ColumnDefinitions="Auto,*"
                      VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            Background="#2563EB"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="P"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                        />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="PassKeep"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Boutons fenêtre -->
                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="WindowButton"
                        Content="─"
                        Click="MinimizeWindow"/>
                <Button Classes="WindowButton"
                        Content="□"
                        Click="MaximizeWindow"/>
                <Button Classes="WindowCloseButton"
                        Content="✕"
                        Click="CloseWindow"/>
            </StackPanel>
            </Grid>
        </Border>

      <!-- CONTENT -->
            <Grid Grid.Row="1"
                  Grid.Column="1"
                  RowDefinitions="Auto,*"
                  Margin="24"
                  RowSpacing="18">

                <Grid ColumnDefinitions="*,Auto"
                  Margin="0,0,0,6">
                <StackPanel Spacing="4">
                    <TextBlock Classes="Title" Name="WelcomeText"/>
                    <TextBlock Classes="Subtitle" Text="Accès rapide à tes comptes"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">

                    <TextBox Classes="ModernBox"
                                 x:Name="SearchBox"
                                 Width="200"
                                 Height="36"
                                 PlaceholderText="Rechercher..."
                                 TextChanged="OnSearchChanged"/>

                        <ComboBox x:Name="FilterTypeBox"
                                  Width="140"
                                  Height="36"
                                  PlaceholderText="Tous les types"
                                  SelectionChanged="OnFilterChanged"/>

                        <Button Classes="IconButton"
                                Height="36"
                                Width="36"
                                ToolTip.Tip="Réinitialiser le filtre"
                                Click="OnResetFiltre">
                            <PathIcon Classes="IconPath"
                                      Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6a6 6 0 0 1-1.76 4.24l1.42 1.42A8 8 0 0 0 20 12c0-4.42-3.58-8-8-8zm-6 8a6 6 0 0 1 1.76-4.24L6.34 6.34A8 8 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3c-3.31 0-6-2.69-6-6z"/>
                        </Button>
                    <Button Classes="IconButton"
                            Click="OnHelpClicked">
                        <PathIcon Classes="IconPath"
                                  Data="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm1-4.5V13a1 1 0 0 1-2 0v-1a1 1 0 0 1 1-1c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2a1 1 0 0 1-2 0c0-2.21 1.79-4 4-4s4 1.79 4 4c0 1.86-1.27 3.43-3 3.5z"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- LIST -->
            <Border Grid.Row="1"
                    Classes="Card">
                <StackPanel Spacing="18">

                        <ItemsControl x:Name="ProfilsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type modeles:ProfilConnexion}">
                                    <views:ProfilConnexionItem/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    <Button Classes="PrimaryButton"
                            Content="+ Ajouter un mot de passe"
                            Click="OnAddProfilViewClicked"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>