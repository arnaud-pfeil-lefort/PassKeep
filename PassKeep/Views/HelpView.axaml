<Window
    x:Class="PassKeep.Views.HelpView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="480"
    Height="560"
    MinWidth="420"
    MinHeight="400"
    Title="PassKeep — Aide"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Color_WindowBg}"
    Topmost="True"
    Icon="/assets/passkeepIcon.png"
    SystemDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40">

    <Grid RowDefinitions="40,*">

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource Color_TitleBarBg}"
                BorderBrush="{DynamicResource Color_TitleBarBorder}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0,12,0">

                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            Background="{DynamicResource Color_Accent}"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="?"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="HelpTitle"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource Color_TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="WindowButton" Content="─" Click="MinimizeWindow"/>
                    <Button Classes="WindowCloseButton" Content="✕" Click="CloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentArea" Margin="20,16,20,24" Spacing="12"/>
        </ScrollViewer>

    </Grid>
</Window>
