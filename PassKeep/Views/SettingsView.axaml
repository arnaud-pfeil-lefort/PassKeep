<Window
    x:Class="PassKeep.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="560"
    MinWidth="380"
    MinHeight="560"
    Title="PassKeep"
    Background="{DynamicResource Color_WindowBg}"
    Topmost="True"
    Icon="/assets/passkeepIcon.png"
    SystemDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40">

    <Grid RowDefinitions="40,*">

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource Color_TitleBarBg}"
                BorderBrush="{DynamicResource Color_TitleBarBorder}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0,12,0">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            Background="{DynamicResource Color_Accent}"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="P"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="PassKeep"
                               Foreground="{DynamicResource Color_TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="WindowButton" Content="─" Click="MinimizeWindow"/>
                    <Button Classes="WindowCloseButton" Content="✕" Click="CloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="24,20,24,24">

            <StackPanel Grid.Row="0" Spacing="20">

                <!-- Header -->
                <TextBlock Classes="Title" Text="Paramètres"/>

                <!-- Apparence -->
                <Border Classes="Card">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Apparence"
                                       Foreground="{DynamicResource Color_TextSecondary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="ThemeLabel"
                                       Foreground="{DynamicResource Color_TextSubtle}"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="ThemeToggleButton"
                                Classes="SecondaryButton"
                                VerticalAlignment="Center"
                                Click="OnThemeToggle"/>
                    </Grid>
                </Border>

                <!-- Types de profil -->
                <Border Classes="Card">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Types de profil"
                                       Foreground="{DynamicResource Color_TextSecondary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Ajouter ou supprimer des catégories"
                                       Foreground="{DynamicResource Color_TextSubtle}"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="SecondaryButton"
                                Content="Gérer"
                                VerticalAlignment="Center"
                                Click="OnGererTypes"/>
                    </Grid>
                </Border>

                <!-- Dictionnaire -->
                <Border Classes="Card">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Dictionnaire"
                                   Foreground="{DynamicResource Color_TextSecondary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Importer un fichier .txt"
                                       Foreground="{DynamicResource Color_TextMuted}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Classes="SecondaryButton"
                                    Content="Importer"
                                    VerticalAlignment="Center"
                                    Click="OnImportDictionnaire"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Color_TitleBarBorder}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Vider le dictionnaire"
                                       Foreground="{DynamicResource Color_TextMuted}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Classes="WindowCloseButton"
                                    Content="Supprimer"
                                    VerticalAlignment="Center"
                                    Click="OnDeleteDictionnaire"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Feedback -->
                <TextBlock x:Name="FeedbackText"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           IsVisible="False"/>

            </StackPanel>

            <!-- Déconnexion -->
            <Button Grid.Row="1"
                    Classes="DangerButton"
                    Content="Se déconnecter"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnLogout"/>

        </Grid>

    </Grid>
</Window>
