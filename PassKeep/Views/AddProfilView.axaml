<Window
    x:Class="PassKeep.Views.AddProfilView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="620"
    MinWidth="380"
    MinHeight="580"
    Title="PassKeep"
    Background="#0B1220"
    Topmost="True"
    Icon="/assets/passkeepIcon.png"
    SystemDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40">

    <Grid RowDefinitions="40,*">

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0,12,0">

                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            Background="#2563EB"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="P"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="PassKeep"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="WindowButton" Content="─" Click="MinimizeWindow"/>
                    <Button Classes="WindowCloseButton" Content="✕" Click="CloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Margin="24">

            <Border Classes="Card" Width="340" Padding="28,32">
                <StackPanel Spacing="0">

                    <!-- Header -->
                    <StackPanel Spacing="4" Margin="0,0,0,28">
                        <TextBlock x:Name="FormTitle" Classes="Title" Text="Nouveau profil"/>
                        <TextBlock x:Name="FormSubtitle" Classes="Subtitle" Text="Ajoute un compte à ton coffre-fort"/>

                    </StackPanel>

                    <!-- Nom du service -->
                       <TextBlock Text="Service"
                               Foreground="#94A3B8"
                               FontSize="13"
                               Margin="0,0,0,6"/>
                    <TextBox Classes="ModernBox"
                             x:Name="ServiceTextBox"
                             Watermark="Google, GitHub..."
                             Margin="0,0,0,16"/>

                    <!-- URL -->
                    <TextBlock Text="URL"
                               Foreground="#94A3B8"
                               FontSize="13"
                               Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="*,8,Auto" Margin="0,0,0,8">
                        <TextBox Classes="ModernBox"
                                 x:Name="UrlTextBox"
                                 Watermark="https://..."/>
                        <Button Grid.Column="2"
                                Classes="SecondaryButton"
                                Content="Vérifier"
                                Click="OnCheckUrl"/>
                    </Grid>

                    <!-- Résultat Safe Browsing -->
                    <TextBlock x:Name="UrlSafetyText"
                               FontSize="12"
                               IsVisible="False"
                               Margin="0,0,0,12"/>

                    <!-- Type de Profil -->
                    <TextBlock Text="Type de Profil"
                                Foreground="#94A3B8"
                                FontSize="13"
                                Margin="0,0,0,6"/>
                    <ComboBox x:Name="TypeProfilComboBox"
                                Classes="ModernBox"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Sélectionner un type..."
                                Margin="0,0,0,16"/>

                    <!-- Login -->
                    <TextBlock Text="Login"
                               Foreground="#94A3B8"
                               FontSize="13"
                               Margin="0,0,0,6"/>
                    <TextBox Classes="ModernBox"
                             x:Name="LoginTextBox"
                             Watermark="vous@exemple.com"
                             Margin="0,0,0,16"/>

                    <!-- Mot de passe -->
                    <TextBlock Text="Mot de passe"
                               Foreground="#94A3B8"
                               FontSize="13"
                               Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="*,8,Auto" Margin="0,0,0,28">
                        <TextBox Classes="ModernBox"
                                 x:Name="PasswordTextBox"
                                 PasswordChar="●"
                                 Watermark="••••••••"/>
                        <Button Grid.Column="2"
                                Classes="SecondaryButton"
                                Content="Générer"
                                Click="OnGeneratePassword"/>
                    </Grid>

                    <!-- Message erreur -->
                    <TextBlock x:Name="ErrorText"
                               Text="Veuillez remplir tous les champs"
                               Foreground="#EF4444"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               IsVisible="False"
                               Margin="0,0,0,12"/>

                    <Button x:Name="DeleteButton"
                        Classes="DangerButton"
                        Content="Supprimer le profil"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsVisible="False"
                        Click="OnDeleteProfil"
                        Margin="0,0,0,8"/>


                    <!-- Bouton Ajouter -->
                    <Button x:Name="SubmitButton"
                        Classes="PrimaryButton"
                        Content="Ajouter le profil"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="OnAddProfil"/>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
