<Window
    x:Class="PassKeep.Views.AddProfilView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400"
    Height="560"
    MinWidth="360"
    MinHeight="520"
    Title="PassKeep"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Color_WindowBg}"
    Topmost="True"
    Icon="/assets/passkeepIcon.png"
    SystemDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40">

    <Grid RowDefinitions="40,*">

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource Color_TitleBarBg}"
                BorderBrush="{DynamicResource Color_TitleBarBorder}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0,12,0">

                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            Background="{DynamicResource Color_Accent}"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="P"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="PassKeep"
                               Foreground="{DynamicResource Color_TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="WindowButton" Content="?" Click="OnHelpClicked" ToolTip.Tip="Aide"/>
                    <Button Classes="WindowButton" Content="─" Click="MinimizeWindow"/>
                    <Button Classes="WindowCloseButton" Content="✕" Click="CloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="28,20,28,24" Spacing="0">

                <!-- Header -->
                <StackPanel Spacing="3" Margin="0,0,0,22">
                    <TextBlock x:Name="FormTitle" Classes="Title" Text="Nouveau profil"/>
                    <TextBlock x:Name="FormSubtitle" Classes="Subtitle" Text="Ajoute un compte à ton coffre-fort"/>
                </StackPanel>

                <!-- Service -->
                <TextBlock Text="Service" Foreground="{DynamicResource Color_TextSubtle}" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Classes="ModernBox" x:Name="ServiceTextBox" Watermark="Google, GitHub..." Margin="0,0,0,14"/>

                <!-- URL -->
                <TextBlock Text="URL (facultatif)" Foreground="{DynamicResource Color_TextSubtle}" FontSize="12" Margin="0,0,0,5"/>
                <Grid ColumnDefinitions="*,8,Auto" Margin="0,0,0,6">
                    <TextBox Classes="ModernBox" x:Name="UrlTextBox" Watermark="https://..."/>
                    <Button Grid.Column="2" Classes="SecondaryButton" Content="Vérifier" Click="OnCheckUrl"/>
                </Grid>
                <TextBlock x:Name="UrlSafetyText" FontSize="12" IsVisible="False" Margin="0,0,0,10"/>

                <!-- Type de Profil -->
                <TextBlock Text="Type" Foreground="{DynamicResource Color_TextSubtle}" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="TypeProfilComboBox"
                          Classes="ModernBox"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Sélectionner un type..."
                          Margin="0,0,0,14"/>

                <!-- Login -->
                <TextBlock Text="Login" Foreground="{DynamicResource Color_TextSubtle}" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Classes="ModernBox" x:Name="LoginTextBox" Watermark="vous@exemple.com" Margin="0,0,0,14"/>

                <!-- Mot de passe -->
                <TextBlock Text="Mot de passe" Foreground="{DynamicResource Color_TextSubtle}" FontSize="12" Margin="0,0,0,5"/>
                <Grid ColumnDefinitions="*,8,Auto" Margin="0,0,0,20">
                    <TextBox Classes="ModernBox" x:Name="PasswordTextBox" PasswordChar="●" Watermark="••••••••"/>
                    <Button Grid.Column="2" Classes="SecondaryButton" Content="Générer" Click="OnGeneratePassword"/>
                </Grid>

                <!-- Message erreur -->
                <TextBlock x:Name="ErrorText"
                           Text="Veuillez remplir tous les champs"
                           Foreground="{DynamicResource Color_Danger}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           IsVisible="False"
                           Margin="0,0,0,10"/>

                <Button x:Name="DeleteButton"
                        Classes="DangerButton"
                        Content="Supprimer le profil"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        IsVisible="False"
                        Click="OnDeleteProfil"
                        Margin="0,0,0,8"/>

                <Button x:Name="SubmitButton"
                        Classes="PrimaryButton"
                        Content="Ajouter le profil"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="OnAddProfil"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
