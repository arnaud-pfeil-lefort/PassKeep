<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================= -->
    <!-- 🪟 WINDOW -->
    <!-- ========================= -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Color_WindowBg}"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>


    <!-- ========================= -->
    <!-- 📌 TITLE BAR -->
    <!-- ========================= -->

    <Style Selector="Button.WindowButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.WindowButton /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Button.WindowButton:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextHover}"/>
    </Style>

    <Style Selector="Button.WindowButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceHoverBorder}"/>
    </Style>

    <Style Selector="Button.WindowButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_SurfacePressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfacePressedBorder}"/>
    </Style>

    <Style Selector="Button.WindowCloseButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource Color_CloseBtn}"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_CloseBtnBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.WindowCloseButton /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_CloseBtn}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_CloseBtnBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Button.WindowCloseButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_CloseBtnHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_CloseBtnHoverBorder}"/>
    </Style>

    <Style Selector="Button.WindowCloseButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_CloseBtnPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_Danger}"/>
    </Style>


    <!-- ========================= -->
    <!-- 🔝 HEADER -->
    <!-- ========================= -->

    <Style Selector="TextBlock.Title">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.Subtitle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextMuted}"/>
    </Style>

    <Style Selector="TextBox.ModernBox">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Color_TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="TextBox.ModernBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="TextBox.ModernBox /template/ TextBlock#Watermark">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextMuted}"/>
    </Style>

    <Style Selector="TextBox.ModernBox /template/ TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextMuted}"/>
    </Style>

    <Style Selector="TextBox.ModernBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Color_SurfaceFocus}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_Focus}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="TextBox.ModernBox:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Color_SurfaceFocus}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_Focus}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="TextBox.ModernBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceHoverBorder}"/>
    </Style>

    <Style Selector="ComboBox.ModernBox">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ComboBox.ModernBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Color_Focus}"/>
    </Style>

    <Style Selector="ComboBox.ModernBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ComboBox.ModernBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceHoverBorder}"/>
    </Style>

    <Style Selector="ComboBox.ModernBox /template/ TextBlock#PlaceholderTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextMuted}"/>
    </Style>

    <Style Selector="ComboBox.ModernBox /template/ ContentControl#PlaceholderTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextMuted}"/>
    </Style>

    <Style Selector="ComboBox.ModernBox /template/ Popup Border">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextPrimary}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_SurfaceHover}"/>
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_Accent}"/>
    </Style>


    <!-- ========================= -->
    <!-- 📦 CARD -->
    <!-- ========================= -->

    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource Color_CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.SectionSubtitle">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextMuted}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="Button.SecondaryButton">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.SecondaryButton /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style Selector="Button.SecondaryButton:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextHover}"/>
    </Style>

    <Style Selector="Button.SecondaryButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceHoverBorder}"/>
    </Style>

    <Style Selector="Button.SecondaryButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_SurfacePressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfacePressedBorder}"/>
    </Style>

    <Style Selector="Button.DangerButton">
        <Setter Property="Background" Value="{DynamicResource Color_Danger}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>


    <!-- ========================= -->
    <!-- 🔐 ACCOUNT ITEM -->
    <!-- ========================= -->

    <Style Selector="Border.AccountItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_TitleBarBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="4,8"/>
    </Style>

    <Style Selector="Border.LogoBox">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{DynamicResource Color_Accent}"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>

    <Style Selector="TextBlock.LogoLetter">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.WebSiteTitle">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextPrimary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.Username">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="160"/>
    </Style>

    <Style Selector="TextBlock.PasswordValue">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>


    <!-- ========================= -->
    <!-- 🎯 ICON BUTTONS -->
    <!-- ========================= -->

    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextIcon}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.IconButton /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Button.IconButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfaceHoverBorder}"/>
    </Style>

    <Style Selector="Button.IconButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_SurfacePressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Color_SurfacePressedBorder}"/>
    </Style>

    <Style Selector="Button.IconButton:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextHover}"/>
    </Style>

    <Style Selector="TextBlock.IconGlyph">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="PathIcon.IconPath">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource Color_TextIcon}"/>
    </Style>

    <Style Selector="Button.IconButton:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Color_TextHover}"/>
    </Style>


    <!-- ========================= -->
    <!-- ➕ PRIMARY BUTTON -->
    <!-- ========================= -->

    <Style Selector="Button.PrimaryButton">
        <Setter Property="Background" Value="{DynamicResource Color_PrimaryBtn}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.PrimaryButton /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_PrimaryBtn}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>

    <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_PrimaryBtnHover}"/>
    </Style>

    <Style Selector="Button.PrimaryButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Color_PrimaryBtnPressed}"/>
    </Style>

</Styles>
