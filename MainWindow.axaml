<Window
    x:Class="PassKeep.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PassKeep.Views"
    xmlns:modeles="clr-namespace:PassKeep.modeles"

    Width="760"
    Height="760"
    MinWidth="600"
    MinHeight="680"
    Title="PassKeep"
    Background="#0B1220"
    Topmost="True"
    Icon="/assets/passkeepIcon.png"
    SystemDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="40">

    <Grid RowDefinitions="40,*">

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="12,0,12,0">

                <!-- Zone draggable -->
                <Grid ColumnDefinitions="Auto,*"
                      VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            Background="#2563EB"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock Text="P"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                        />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="PassKeep"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Boutons fenêtre -->
                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="WindowButton"
                        Content="─"
                        Click="MinimizeWindow"/>
                <Button Classes="WindowButton"
                        Content="□"
                        Click="MaximizeWindow"/>
                <Button Classes="WindowCloseButton"
                        Content="✕"
                        Click="CloseWindow"/>
            </StackPanel>
            </Grid>
        </Border>

      <!-- CONTENT -->
<Grid Grid.Row="1"
      Grid.Column="1"
      RowDefinitions="Auto,*"
      Margin="24"
      RowSpacing="18">

    <!-- TOP -->
    <Grid ColumnDefinitions="*,Auto"
          Margin="0,0,0,6">
        <StackPanel Spacing="4">
            <TextBlock Classes="Title" Name="WelcomeText"/>
            <TextBlock Classes="Subtitle" Text="Accès rapide à tes comptes"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
            <TextBox Classes="ModernBox"
                     Width="260"
                     Height="36"
                     PlaceholderText="Rechercher..."/>
            <Button Classes="IconButton"
                    Click="OnSettingsClicked">
                <PathIcon Classes="IconPath"
                          Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm7.07-2.07a7 7 0 0 0 .07-1 7 7 0 0 0-.07-.93l2-1.56a.5.5 0 0 0 .12-.63l-1.89-3.27a.5.5 0 0 0-.61-.22l-2.36.95a7 7 0 0 0-1.6-.93l-.36-2.51A.49.49 0 0 0 14 3h-4a.49.49 0 0 0-.49.43l-.36 2.51a7 7 0 0 0-1.6.93l-2.36-.95a.49.49 0 0 0-.61.22L2.69 9.41a.48.48 0 0 0 .12.63l2 1.56a7.154 7.154 0 0 0 0 1.86l-2 1.56a.48.48 0 0 0-.12.63l1.89 3.27c.13.22.4.3.61.22l2.36-.95c.5.35 1.03.63 1.6.93l.36 2.51c.06.26.28.43.49.43h4c.22 0 .43-.17.49-.43l.36-2.51a7 7 0 0 0 1.6-.93l2.36.95c.23.08.48 0 .61-.22l1.89-3.27a.48.48 0 0 0-.12-.63l-2-1.56z"/>
            </Button>
            </StackPanel>
        </Grid>

            <!-- LIST -->
            <Border Grid.Row="1"
                    Classes="Card">
                <StackPanel Spacing="18">

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,0,0,4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Comptes"
                                       Classes="SectionTitle"/>
                            <TextBlock Text="Liste des entrées enregistrées"
                                       Classes="SectionSubtitle"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="SecondaryButton"
                                Content="Trier"/>
                    </Grid>

                        <ItemsControl x:Name="ProfilsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type modeles:ProfilConnexion}">
                                    <views:ProfilConnexionItem/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    <Button Classes="PrimaryButton"
                            Content="+ Ajouter un mot de passe"
                            Click="OnAddProfilViewClicked"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>